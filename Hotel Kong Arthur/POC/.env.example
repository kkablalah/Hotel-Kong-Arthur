# Skabelon til .env. Kopiér filen til .env, og skift adgangskoden.
# .env må aldrig committes (constitution princip VI).
# Adgangskoden sættes første gang databasen oprettes. Skiftes den senere,
# kræver det docker-compose down -v, som også sletter nye data i databasen.

# Database. DB_HOST er servicenavnet i docker-compose, ikke localhost.
DB_HOST=db
DB_PORT=5432
DB_USER=hotel_app
DB_PASSWORD=skift_mig
DB_NAME=hotel

# Det år, de historiske ophold i stays hører til (antagelse, BR-04).
HISTORIK_AAR=2025

# Tableau-eksport
API_BASE_URL=http://backend:8000
EXPORT_INTERVAL_SECONDS=60
